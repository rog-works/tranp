{%- if condition.startswith('std::is_same_v') -%}
if constexpr ({{ condition }}) {
	{%- filter indent('\t') %}
		{%- for statement in statements %}
{{ statement }}
		{%- endfor %}
	{%- endfilter %}
	{%- for else_if in else_ifs %}
{{ else_if }}
	{%- endfor %}
} else {
	{%- set condition_type = reg_match('^std::is_same_v<([^,]+),', condition)[1] %}
	static_assert(std::is_same_v<{{ condition_type }}, void>, "Unmatch type");
}
{%- else -%}
if ({{ condition }}) {
	{%- filter indent('\t') %}
		{%- for statement in statements %}
{{ statement }}
		{%- endfor %}
	{%- endfilter %}
	{%- for else_if in else_ifs %}
{{ else_if }}
	{%- endfor %}
	{%- if else_clause %}
{{ else_clause }}
	{%- endif %}
}
{%- endif -%}
