{#- XXX 負の値の対応は、変数に代入された場合に対処できず、片手落ちとなるため非対応とする -#}
[&]() -> {{ var_type }} {
	{{ var_type }} l_ret;
	auto l_begin = {{ receiver }}.{{ i18n('cpp', 'vector.begin') }}();
	auto l_end = {{ keys[1] if keys[1] else receiver + '.' + i18n('cpp', 'container.size') + '()' }};
	for (auto l_index = {{ keys[0] if keys[0] else '0' }}; l_index < l_end; l_index += {{ keys[2] if keys[2] else '1' }}) {
		l_ret.{{ i18n('classes', 'list.append') }}(*(l_begin + l_index));
	}
	return l_ret;
}(){% if is_statement %};{% endif %}
